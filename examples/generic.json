{
  "schema_version": 1,
  "doctor": {
    "model_path": "./models/example-model",
    "expected_gpus": null
  },
  "data": {
    "check": {
      "annotation": "./data/train.jsonl",
      "data_root": "./data/media",
      "sample_limit": 1000,
      "full_scan": false,
      "compute_hash": false,
      "verify_images": true,
      "group_id": "group_id",
      "messages": "messages",
      "media": "media",
      "split": "split",
      "report_dir": "./reports/data_check"
    }
  },
  "run": {
    "watch": {
      "framework": "generic",
      "once": true,
      "interval": 30,
      "output_dir": "./outputs",
      "log_file": "./outputs/train.log",
      "expected_gpus": null,
      "stale_log_minutes": 15.0,
      "disk_free_gb_threshold": 10.0
    }
  }
}
